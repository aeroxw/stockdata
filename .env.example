# StockData 环境变量样例
#
# 用法：cp .env.example .env，然后填入真实值。
# .env 已被 .gitignore 排除，**不要提交到仓库**。
#
# docker compose（包括 NAS 上的部署脚本）会自动加载本文件；
# 绿联 Container Manager 的 UI 不会读它，那种情况请把值直接写进
# compose 的 environment 里。

# ---- 必填：数据库密码 ----
# 部署到生产环境前务必改掉，示例值只是占位。
POSTGRES_PASSWORD=change_me

# ---- 必填：JWT 签名密钥 ----
# 生成方式：openssl rand -base64 48
# 换了它会导致所有已登录用户掉线（这是预期行为）。
JWT_SECRET=change_me

# ---- 同花顺 API 密钥 ----
# 留空时特色数据接口（涨停池 / 龙虎榜等）会整体不可用，
# 快照与 K 线会由其他数据源兜底，不影响主体功能。
HITHINK_API_KEY=

# ---- 数据源地址 ----
# 同花顺的地址保持默认即可。
# easy-tdx 与开盘了代理是**你自己搭的**服务（不在本仓库范围内）；
# 没搭就留空/保留 localhost，对应数据源会自动降级，其余五家照常工作。
HITHINK_BASE=https://fuyao.aicubes.cn
EASYTDX_BASE=http://127.0.0.1:8000
KPL_PROXY_BASE=http://127.0.0.1:8018
